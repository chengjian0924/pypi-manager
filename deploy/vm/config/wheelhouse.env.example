# ============================================================================
# 方案 A：内网虚拟机「直接部署」唯一配置文件
# ----------------------------------------------------------------------------
# 用法：
#   cp deploy/vm/config/wheelhouse.env.example deploy/vm/config/wheelhouse.env
#   vi  deploy/vm/config/wheelhouse.env
#   deploy/vm/bin/start.sh
#
# 本文件只被 deploy/vm/bin/*.sh 读取，与 deploy/docker/ 无任何关系。
# wheelhouse.env 含密码/TLS 私钥路径，已由 deploy/vm/.gitignore 排除入库。
# 所有变量统一前缀 VM_WH_，避免与 Docker 方案的 DK_ / WH_ 变量串用。
# 亦可通过环境变量 VM_WH_CONF_FILE 指向 /etc/wheelhouse/wheelhouse.env。
# ============================================================================

# --- 运行依赖 ---------------------------------------------------------------
# Python >= 3.10（仅标准库，零 pip 依赖）；SQLite >= 3.24（随 Python 提供）
# 系统包：python3、ca-certificates、curl（仅验证用，可选）、openssl（生成证书用）
VM_WH_PYTHON=/usr/bin/python3
# 仓库根目录（其下应有 backend/app.py 与 frontend/index.html）
# 留空 = 自动取 deploy/vm 所在仓库的根目录
VM_WH_APP_DIR=

# --- 路径 -------------------------------------------------------------------
# --data：pypi.db、packages/、.trash/、.tmp/、.orphans/、audit.jsonl
VM_WH_DATA_DIR=/var/lib/wheelhouse
# --backup-dir：在线备份输出目录，应与数据目录位于不同磁盘
VM_WH_BACKUP_DIR=/var/backups/wheelhouse
VM_WH_LOG_DIR=/var/log/wheelhouse
# PID 文件所在目录（systemd 下由 RuntimeDirectory 自动创建）
VM_WH_RUN_DIR=/run/wheelhouse
# 前端静态资源目录；留空 = $VM_WH_APP_DIR/frontend
VM_WH_FRONTEND_DIR=
# 直接启用 HTTPS 时填写 PEM 证书与私钥；留空则由前置反代终止 TLS
VM_WH_TLS_CERT=
VM_WH_TLS_KEY=

# --- 端口与监听 -------------------------------------------------------------
# 推荐 127.0.0.1 + 前置 Nginx 终止 TLS；如需直连局域网请填 0.0.0.0 并配置证书
VM_WH_HOST=127.0.0.1
VM_WH_PORT=8080
# 监听非本机地址且未配置 TLS 时，是否显式放行明文 HTTP（0 = 拒绝启动）
VM_WH_ALLOW_INSECURE_HTTP=0

# --- 权限与容量 -------------------------------------------------------------
# 1 = /simple/ 与 /files/ 也需登录（pip 需配 .netrc）；0 = 匿名可读
VM_WH_REQUIRE_AUTH_FOR_READ=1
VM_WH_MAX_UPLOAD_MB=512
VM_WH_MAX_WORKERS=64
VM_WH_MIN_FREE_MB=2048

# --- 备份 / 回收站 / 审计 ---------------------------------------------------
VM_WH_BACKUP_INTERVAL_HOURS=24
VM_WH_BACKUP_KEEP=14
VM_WH_TRASH_DAYS=30
VM_WH_TRASH_MAX_MB=2048
VM_WH_AUDIT_MAX_MB=10
VM_WH_AUDIT_KEEP=5

# --- 运行日志 ---------------------------------------------------------------
# 日志写 stderr；start.sh 后台模式重定向到 $VM_WH_LOG_DIR/wheelhouse.log，
# systemd 前台模式由 journald 接管（journald 自带容量上限，无需本段配置轮转）。
# 级别：DEBUG / INFO / WARNING / ERROR
VM_WH_LOG_LEVEL=INFO
# 1 = 单行 JSON（便于 Loki/ES 采集）；0 = 人类可读文本
VM_WH_LOG_JSON=0
# 请求耗时超过该毫秒数按 WARNING 记录，便于定位慢接口；0 = 关闭
VM_WH_SLOW_MS=1000

# --- 首次初始化管理员（仅 init-admin.sh 使用） ------------------------------
VM_WH_INIT_USER=admin
# 留空 = 执行 init-admin.sh 时交互式输入（推荐，密码不会出现在文件/进程列表）
VM_WH_INIT_PASSWORD=
VM_WH_INIT_ROLE=admin
VM_WH_INIT_SCOPE=*

# --- 验证用的可选账号（仅 verify.sh 使用，留空则跳过登录态检查） -----------
VM_WH_VERIFY_USER=
VM_WH_VERIFY_PASSWORD=

# --- 进程管理 ---------------------------------------------------------------
# systemd 单元使用的运行用户；手工执行脚本时请自行切换到该用户
VM_WH_SERVICE_USER=wheelhouse
VM_WH_STOP_TIMEOUT=30
# systemd 主单元名称（watchdog 恢复时 systemctl restart 用；改过单元名请同步）
VM_WH_SERVICE_UNIT=wheelhouse

# --- 24×7 无人值守自愈（仅 watchdog.sh 与 systemd timer 读取） ----------------
# 连续几次 /health 失败才触发恢复；配合 timer 30s，默认 3 次 ≈ 90s
VM_WH_WATCHDOG_FAILS=3
# 两次恢复动作的最小间隔（秒），防止抖动导致反复重启
VM_WH_WATCHDOG_COOLDOWN=120
# 连续恢复这么多次仍不健康就熔断，停止自动重启并告警，等待人工 --reset
VM_WH_WATCHDOG_MAX_RECOVERIES=3
# 执行恢复命令后等待服务重新就绪的秒数
VM_WH_WATCHDOG_WAIT_READY=45
# --loop 模式的检查间隔（秒）；用 systemd timer 时由 OnUnitActiveSec 控制，此项只影响 loop
VM_WH_WATCHDOG_INTERVAL=30
# 恢复命令（含空格必须加引号）。留空 = 按 VM_WH_SERVICE_UNIT 自动生成
# `systemctl restart wheelhouse`；systemd 托管时保持留空即可。
# 不用 systemd、只用 start.sh 管理时改成脚本绝对路径，例如：
# VM_WH_WATCHDOG_RECOVER_CMD="/opt/wheelhouse/app/deploy/vm/bin/start.sh"
VM_WH_WATCHDOG_RECOVER_CMD=
# 自定义健康探测命令（留空 = 用内置 /health，自动绕过全局代理）。
# 想从外部网关探测 HTTPS 入口时可填，例如：
# VM_WH_WATCHDOG_PROBE_CMD='curl -fsS --noproxy "*" https://pypi.intra.example.com/health -o /dev/null'
VM_WH_WATCHDOG_PROBE_CMD=
# 告警命令（可选）。消息通过环境变量 WATCHDOG_MESSAGE 传入，含 $ 请用单引号：
# VM_WH_WATCHDOG_ALERT_CMD='curl -fsS -X POST -d "text=$WATCHDOG_MESSAGE" https://告警网关/hook'
VM_WH_WATCHDOG_ALERT_CMD=
# 计划内停机时创建此文件即可暂停自愈（维护结束后删除）
VM_WH_WATCHDOG_PAUSE_FILE=/run/wheelhouse/watchdog.pause
