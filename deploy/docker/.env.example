# ============================================================================
# 方案 B：Docker 部署唯一配置文件
# ----------------------------------------------------------------------------
# 用法：
#   cp deploy/docker/.env.example deploy/docker/.env
#   vi  deploy/docker/.env
#   deploy/docker/bin/start.sh
#
# 本文件只被 deploy/docker/compose.yaml 与 deploy/docker/bin/*.sh 读取，
# 与 deploy/vm/ 无任何关系。.env 含密码，已由 deploy/docker/.gitignore 排除入库。
# 所有变量统一前缀 DK_（宿主机/Compose 层）；容器内运行参数经 compose 映射为 WH_。
# 亦可通过环境变量 DK_ENV_FILE 指向别的 .env 文件。
# ============================================================================

# --- 镜像 / 容器 ------------------------------------------------------------
# 基础镜像仅含 Python 3.12 标准库，构建过程不执行 pip install（零第三方依赖）
DK_BASE_IMAGE=python:3.12-slim
DK_IMAGE_NAME=wheelhouse-intranet
DK_IMAGE_TAG=1.1
DK_CONTAINER_NAME=wheelhouse
DK_RESTART_POLICY=unless-stopped
# 每次 start.sh 是否重新构建镜像（1=构建，0=镜像已存在则直接启动）
DK_BUILD_ON_START=1
# 容器内进程 UID/GID；使用宿主机 bind 挂载时需把目录 chown 为此值
DK_UID=10001
DK_GID=10001
DK_TZ=Asia/Shanghai

# --- 端口 -------------------------------------------------------------------
# 默认值故意与虚拟机方案的 8080 不同，两套方案可同时验证而互不抢占。
#
# DK_HOST_BIND=127.0.0.1 表示「只有本机能直连」，是给「前面挂 Nginx / 网关」的
# 安全默认值：SELinux、云安全组、误暴露公网都省心。此时同事要访问，
#   由本机 Nginx 监听 443 反代到 127.0.0.1:8081（TLS 在 Nginx 终止，推荐），
#   或把下面这行改成 0.0.0.0 —— 直接把明文 HTTP 暴露到局域网，
#   Basic 认证口令可被抓包解出，必须配合 TLS 或确认内网可信。
DK_HOST_BIND=127.0.0.1
DK_HOST_PORT=8081
DK_CONTAINER_PORT=8080

# --- 路径 / 卷 --------------------------------------------------------------
# 默认使用 Docker 命名卷（推荐，数据不落在宿主机项目目录里）。
# 如需宿主机目录，改成绝对路径，例如 /srv/wheelhouse/data，
# 并先执行 chown -R 10001:10001 该目录。
DK_DATA_SOURCE=wheelhouse-data
DK_BACKUP_SOURCE=wheelhouse-backup
# 宿主 TLS 证书目录（只读挂载到容器 /tls）；不用 TLS 时保持默认即可
DK_TLS_DIR=./runtime/tls
# 填容器内路径以启用 HTTPS，例如 /tls/fullchain.pem 与 /tls/privkey.pem
DK_TLS_CERT=
DK_TLS_KEY=

# --- 容器内运行参数（compose 映射为 WH_* 环境变量，由 entrypoint.sh 转 CLI） -
# 1 = /simple/ 与 /files/ 也需登录；0 = 匿名可读
DK_REQUIRE_AUTH_FOR_READ=1
# 容器固定监听 0.0.0.0；无 TLS 时 app.py 会因非回环地址拒绝启动，
# 置 1 表示「已在容器前置反代/网关终止 TLS」，由 entrypoint 显式加 --insecure-http
DK_ALLOW_INSECURE_HTTP=1
DK_MAX_UPLOAD_MB=512
DK_MAX_WORKERS=64
DK_MIN_FREE_MB=2048
DK_BACKUP_INTERVAL_HOURS=24
DK_BACKUP_KEEP=14
DK_TRASH_DAYS=30
DK_TRASH_MAX_MB=2048
DK_AUDIT_MAX_MB=10
DK_AUDIT_KEEP=5
# 运行日志级别：DEBUG / INFO / WARNING / ERROR
DK_LOG_LEVEL=INFO
# 1 = 容器 stdout 输出单行 JSON（便于 Loki/ES 采集）；0 = 人类可读文本
DK_LOG_JSON=0
# 请求耗时超过该毫秒数按 WARNING 记录；0 = 关闭
DK_SLOW_MS=1000

# --- 容器日志轮转（docker json-file driver） --------------------------------
# 不加限制时容器日志默认无限增长，长期运行会写满宿主机磁盘，必须限制。
# 改动后需 docker compose up -d 重建容器才生效（restart 不会改 logging 配置）。
DK_LOG_MAX_SIZE=20m
DK_LOG_MAX_FILE=5

# --- 首次初始化管理员（仅 bootstrap.sh 使用） -------------------------------
DK_INIT_USER=admin
# 留空 = 执行 bootstrap.sh 时交互式输入（推荐）
DK_INIT_PASSWORD=
DK_INIT_ROLE=admin
DK_INIT_SCOPE=*

# --- 验证用的可选账号（仅 verify.sh 使用，留空则跳过登录态检查） -----------
DK_VERIFY_USER=
DK_VERIFY_PASSWORD=

# --- 24×7 无人值守自愈（仅 watchdog.sh 与宿主侧 systemd timer 读取） ---------
# 两层分工：
#   DK_RESTART_POLICY=unless-stopped + `systemctl enable docker`
#       → 容器崩溃 / daemon 重启 / 宿主机重启后自动恢复；
#   watchdog.sh（本段配置）
#       → 容器仍 Running 但 HEALTHCHECK=unhealthy 时主动 compose restart；
#         容器被 docker rm 误删时 compose up -d 重建；
#         容器处于 stop 状态（bin/stop.sh 计划内停机）时不动作。
DK_WATCHDOG_FAILS=3
DK_WATCHDOG_COOLDOWN=120
DK_WATCHDOG_MAX_RECOVERIES=3
DK_WATCHDOG_WAIT_READY=60
DK_WATCHDOG_INTERVAL=30
# 自定义探测命令（留空 = 用容器 HEALTHCHECK 状态，只需 docker）。
# 想从外部网关探测时可用，例如：
# DK_WATCHDOG_PROBE_CMD='curl -fsS --noproxy "*" https://pypi.intra.example.com/health -o /dev/null'
DK_WATCHDOG_PROBE_CMD=
# 告警命令（可选）。消息通过环境变量 WATCHDOG_MESSAGE 传入，含 $ 请用单引号：
# DK_WATCHDOG_ALERT_CMD='curl -fsS -X POST -d "text=$WATCHDOG_MESSAGE" https://告警网关/hook'
DK_WATCHDOG_ALERT_CMD=
# 状态文件与暂停标记（默认落在 deploy/docker/runtime/，已被 .gitignore 排除）
DK_WATCHDOG_STATE_FILE=
DK_WATCHDOG_PAUSE_FILE=
